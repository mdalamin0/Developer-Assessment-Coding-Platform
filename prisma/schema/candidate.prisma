model Candidate {
  id            String   @id @default(uuid())
  contactNumber         String?
  bio           String?
  resumeUrl     String?
  skills        String[]
  experience    Int?
  githubUrl     String?
  linkedinUrl   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String   @unique
  user User @relation(fields: [userId], references: [id])

  @@map("candidates")
}