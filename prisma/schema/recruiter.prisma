model Recruiter {
  id                 String   @id @default(uuid())
  companyName        String
  companyWebsite     String?
  companyLogo        String?
  companyDescription String?
  designation        String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId             String   @unique
  user User @relation(fields: [userId], references: [id])

  @@map("recruiters")
}