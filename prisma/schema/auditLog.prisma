

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  action    AuditAction
  entity    AuditEntity
  entityId  String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime    @default(now())

  user User @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}